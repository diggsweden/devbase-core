#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Digg - Agency for Digital Government
# SPDX-License-Identifier: MIT
# Managed by DevBase: sandboxed OpenCode launcher

set -euo pipefail
fail() {
  printf 'devbase opencode: %s\n' "$*" >&2
  exit 1
}
# Inspect a copy of argv; never rewrite the arguments passed to OpenCode.
# Recognize OpenCode 1.x global/TUI options so their values aren't mistaken for
# commands. Unknown leading options fail closed instead of hiding a subcommand.
check_subcommand() (
  while (($#)); do
    case "$1" in
    --) return 0 ;;
    --log-level | --model | -m | --session | -s | --prompt | --agent | --replay-limit | --port | --hostname | --mdns-domain | --cors)
      (($# >= 2)) || fail "Missing value for $1"
      shift 2
      ;;
    --log-level=* | --model=* | --session=* | --prompt=* | --agent=* | --replay-limit=* | --port=* | --hostname=* | --mdns-domain=* | --cors=*) shift ;;
    --help | -h | --version | -v | --print-logs | --pure | --continue | -c | --fork | --auto | --yolo | --dangerously-skip-permissions | --mini | --replay | --no-replay | --demo | --mdns | --no-mdns | --no-print-logs | --no-pure)
      shift
      case "${1:-}" in true | false) shift ;; esac
      ;;
    --help=* | --version=* | --print-logs=* | --pure=* | --continue=* | --fork=* | --auto=* | --yolo=* | --dangerously-skip-permissions=* | --mini=* | --replay=* | --no-replay=* | --demo=* | --mdns=*) shift ;;
    attach) fail 'Attaching to an external server does not sandbox its tools; start a local session instead.' ;;
    upgrade) fail 'OpenCode is pinned by devbase; update it through devbase setup.' ;;
    acp | mcp | run | generate | debug | console | providers | auth | agent | uninstall | serve | web | models | stats | export | import | github | pr | session | plugin | db | completion) return 0 ;;
    -*) fail "Unsupported leading option: $1; put the subcommand before its options." ;;
    # Yargs can find a command after an earlier positional project argument.
    *) shift ;;
    esac
  done
)
check_subcommand "$@"
for arg in "$@"; do
  [[ "$arg" != -- ]] || break
  case "$arg" in --attach | --attach=*) fail 'External server attachment is not supported by the sandbox launcher.' ;; esac
done
root=$(dirname -- "$(realpath -e -- "${BASH_SOURCE[0]}")")
[[ -r "$root/runtime.json" ]] || fail 'AI pack is not configured; rerun devbase setup with the ai pack.'
command -v jq >/dev/null || fail 'jq is required.'
mise=$(jq -er '.mise' "$root/runtime.json")
mise_data=$(jq -er '.mise_data' "$root/runtime.json")
opencode_ref=$(jq -er '.opencode' "$root/runtime.json")
nono_ref=$(jq -er '.nono' "$root/runtime.json")
pack_version=$(jq -er '.pack_version' "$root/runtime.json")
[[ -x "$mise" ]] || fail 'The configured mise executable is missing; rerun devbase setup.'

# Ignore ambient nono flags (especially NONO_ALLOW/capability elevation) and
# project-controlled mise configuration. Lookup never installs or executes tools.
for var in ${!NONO_@} ${!MISE_@}; do unset "$var"; done
export MISE_DATA_DIR="$mise_data" MISE_AUTO_INSTALL=false
opencode_dir=$("$mise" --no-config where "$opencode_ref") || fail 'Pinned OpenCode is not installed; rerun devbase setup.'
nono_dir=$("$mise" --no-config where "$nono_ref") || fail 'Pinned nono is not installed; rerun devbase setup.'
opencode=$(realpath -e -- "$opencode_dir/opencode") || fail 'OpenCode executable is missing.'
nono=$(realpath -e -- "$nono_dir/nono") || fail 'nono executable is missing.'
[[ -x "$opencode" && -x "$nono" ]] || fail 'OpenCode and nono must be executable.'
"$nono" list --installed --json | jq -e --arg version "$pack_version" \
  '.packages["nolabs-ai/opencode-v1"] | .version == $version and .pinned == true' >/dev/null ||
  fail 'The pinned nolabs-ai/opencode-v1 pack is missing or changed; rerun devbase setup.'

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
workspace=$(pwd -P)
# Stay within the chosen directory. cd to a worktree root to grant the worktree.
home=$(realpath -e -- "$HOME")
[[ "$workspace" != / && "$workspace" != "$home" && "$home" != "$workspace/"* ]] || fail 'Run from a project directory, not home or a parent of home.'

protected=("$root" "$mise_data" "${XDG_BIN_HOME:-$HOME/.local/bin}" "$XDG_CONFIG_HOME/devbase" "$XDG_CONFIG_HOME/mise" "$XDG_CONFIG_HOME/nono")
writable=("$workspace" "$XDG_CONFIG_HOME/opencode" "$XDG_DATA_HOME/opencode" "$XDG_STATE_HOME/opencode" "$XDG_CACHE_HOME/opencode")
for path in "${writable[@]}"; do
  path=$(realpath -m -- "$path")
  [[ "$path" != / && "$path" != "$home" ]] || fail 'Unsafe OpenCode writable directory.'
  for guard in "${protected[@]}"; do
    guard=$(realpath -m -- "$guard")
    [[ "$path" != "$guard" && "$guard" != "$path/"* && "$path" != "$guard/"* ]] || fail "Writable directory overlaps managed tools or policy: $path"
  done
done
mkdir -p -- "$XDG_CONFIG_HOME/opencode" "$XDG_DATA_HOME/opencode" "$XDG_STATE_HOME/opencode" "$XDG_CACHE_HOME/opencode/tmp"
export TMPDIR="$XDG_CACHE_HOME/opencode/tmp"
export OPENCODE_DISABLE_AUTOUPDATE=true

# Include grants inherited from the signed pack and its policy groups, not only
# the paths added above. Inspect the expanded manifest and resolve symlinks.
# Profile drafts are intentionally writable; active profiles/packages are not.
effective_protected=("$root" "$mise_data" "$mise" "$opencode" "$nono" "${XDG_BIN_HOME:-$HOME/.local/bin}" "$XDG_CONFIG_HOME/devbase" "$XDG_CONFIG_HOME/mise" "$XDG_CONFIG_HOME/nono/profiles" "$XDG_CONFIG_HOME/nono/packages")
grants=$("$nono" profile show nolabs-ai/opencode-v1 --format manifest --json |
  jq -ce '.filesystem.grants | if type == "array" and all(.[];
    (.path | type == "string" and startswith("/")) and
    (.access == "read" or .access == "write" or .access == "readwrite"))
    then . else error("Invalid filesystem grants") end') || fail 'Cannot inspect the effective nono filesystem policy.'
while IFS= read -r -d '' path; do
  path=$(realpath -m -- "$path")
  for guard in "${effective_protected[@]}"; do
    guard=$(realpath -m -- "$guard")
    [[ "$path" != / && "$path" != "$guard" && "$guard" != "$path/"* && "$path" != "$guard/"* ]] ||
      fail "Sandbox writable grant overlaps managed tools or policy: $path ($guard)"
  done
done < <(
  jq -j '.[] | select(.access != "read") | .path + "\u0000"' <<<"$grants"
  printf '%s\0' "${writable[@]}"
)

# The OpenCode arguments are after -- and can never become nono flags.
# Use resolved executables, never a bare opencode name (which would recurse).
exec "$nono" run --profile nolabs-ai/opencode-v1 --workdir "$workspace" --allow-cwd \
  --read "$mise_data" --read "$XDG_CONFIG_HOME/mise" --read "$(dirname -- "$opencode")" \
  --allow "$XDG_CONFIG_HOME/opencode" --allow "$XDG_DATA_HOME/opencode" \
  --allow "$XDG_STATE_HOME/opencode" --allow "$XDG_CACHE_HOME/opencode" \
  -- "$opencode" "$@"

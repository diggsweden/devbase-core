// Gradle initialization script for internal repositories
// This file is processed during devbase setup and installed to ~/.gradle/init.gradle
// Applies repository configuration globally to all Gradle projects
// Assumes Nexus-style repository structure

// Rewrite standard public sources, preserving unrelated Settings repositories.
def routePublicRepositories = { repositories ->
    repositories.all { repository ->
        if (repository instanceof org.gradle.api.artifacts.repositories.MavenArtifactRepository) {
            def upstream = repository.url.toString().replaceAll('/+$', '')
            if (upstream == 'https://plugins.gradle.org/m2') {
                repository.url = '${DEVBASE_REGISTRY_URL}/repository/gradle-plugins/'
            } else if (upstream in ['https://repo.maven.apache.org/maven2', 'https://repo1.maven.org/maven2']) {
                repository.url = '${DEVBASE_REGISTRY_URL}/repository/maven-public/'
            }
        }
    }
}

// Settings plugins need their repositories before settings evaluation.
beforeSettings { settings ->
    routePublicRepositories(settings.pluginManagement.repositories)
    settings.pluginManagement {
        repositories {
            maven {
                name = "InternalPluginReleases"
                url = "${DEVBASE_REGISTRY_URL}/repository/maven-public/"
            }
            maven {
                name = "InternalGradlePlugins"
                url = "${DEVBASE_REGISTRY_URL}/repository/gradle-plugins/"
            }
        }
    }
}

// Use Settings repositories; do not inject project repositories into builds
// that enforce FAIL_ON_PROJECT_REPOS.
settingsEvaluated { settings ->
    def dependencies = settings.dependencyResolutionManagement
    routePublicRepositories(dependencies.repositories)
    if (dependencies.repositoriesMode.get() != org.gradle.api.initialization.resolve.RepositoriesMode.FAIL_ON_PROJECT_REPOS) {
        dependencies.repositoriesMode.set(org.gradle.api.initialization.resolve.RepositoriesMode.PREFER_SETTINGS)
    }
    dependencies.repositories {
        // Internal Maven Central Mirror
        maven {
            name = "InternalMavenCentral"
            url = "${DEVBASE_REGISTRY_URL}/repository/maven-public/"
        }
    }
}

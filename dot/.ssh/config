# SSH Configuration Template
# DevBase default SSH configuration with strong security
#
# Order matters - first match wins!
# 1. Personal config (highest priority - can override everything)
# 2. Organization config (can override devbase defaults)
# 3. DevBase defaults (lowest priority)
#
# To add SSH hosts:
#   - Personal: ~/.config/ssh/user.config
#   - Custom/Organization: ~/.config/ssh/custom.config

# Personal SSH hosts (highest priority - can override everything)
Include ~/.config/ssh/user.config

# Custom/Organization SSH hosts (can override devbase defaults)
Include ~/.config/ssh/custom.config

# DevBase defaults (lowest priority - catch-all)
Host *
  # Security settings
  HashKnownHosts yes
  AddKeysToAgent yes
  StrictHostKeyChecking yes
  VisualHostKey yes
  
  # Use maintained OpenSSH key/signature and key-exchange defaults, including
  # security keys and hybrid post-quantum key exchange when supported.
  Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
  MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com

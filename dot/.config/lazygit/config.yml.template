# ~/.config/lazygit/config.yml
# Theme: ${DEVBASE_THEME}
gui:
  # Nerd Fonts are installed by DevBase
  nerdFontsVersion: "3"
git:
  # Same diff rendering as `git diff`; devbase-theme updates the mode
  diffRenderers:
    - command: delta --${DELTA_MODE} --paging=never
os:
  # Follows the editor chosen during setup
  editPreset: ${EDITOR}

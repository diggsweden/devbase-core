# Editor aliases based on EDITOR preference

# Neovim replaces vi/vim when installed; plain Vim is the fallback.
if command -q nvim
    alias vi='nvim'
    alias vim='nvim'
    alias vimbare='nvim -u NONE -N'
else if command -q vim
    alias vi='vim'
    alias vimbare='vim -u NONE -N'
end

if string match -q "*vim*" "$EDITOR"; or test "$EDITOR" = "vi"
    # Vim user aliases
    alias v='$EDITOR'
    alias view='$EDITOR -R'
    # Only point at a configuration that exists (LazyVim creates init.lua).
    if command -q nvim; and test -f ~/.config/nvim/init.lua
        alias vimrc='nvim ~/.config/nvim/init.lua'
    else if test -f ~/.vimrc
        alias vimrc='vim ~/.vimrc'
    end
else
    # Non-vim user aliases
    alias edit='$EDITOR'
end

# Common editor-agnostic aliases
alias fishconfig='$EDITOR ~/.config/fish/config.fish'
alias e='$EDITOR'
alias se='sudo $EDITOR'

# IntelliJ IDEA
alias idea='$HOME/.local/share/JetBrains/IntelliJIdea/bin/idea'

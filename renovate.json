{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>diggsweden/.github//renovate-base.json"
  ],
  "mise": {
    "managerFilePatterns": [
      "/(^|/)dot/\\.config/mise/config\\.toml$/",
      "/(^|/)\\.mise\\.toml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Allow current and announced Java LTS lines, requiring Adoptium's LTS marker",
      "matchDatasources": ["java-version"],
      "matchPackageNames": ["java-temurin"],
      "ignoreUnstable": true,
      "allowedVersions": "/^(25|29)\\..*\\.LTS$/"
    },
    {
      "description": "Allow approved Node lines only after upstream promotes them to LTS",
      "matchDatasources": ["node-version"],
      "matchPackageNames": ["node"],
      "versioning": "node",
      "ignoreUnstable": true,
      "allowedVersions": "/^v?(24|26|27|28)\\./"
    },
    {
      "description": "Keep the Aqua yq tool, package manifest and parser bootstrap pins together",
      "matchPackageNames": ["mikefarah/yq"],
      "groupName": "yq"
    },
    {
      "description": "Skip rumdl v0.1.72 — aqua attestation verification fails (upstream workflow-ref pattern mismatch)",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["rvben/rumdl"],
      "allowedVersions": "!=v0.1.72",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "JetBrains versions can have four parts (2025.3.6.1), which semver cannot order",
      "matchDatasources": ["custom.jetbrains"],
      "versioning": "loose"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)libs/install-mise\\.sh$/",
        "/(^|/)libs/install\\.sh$/"
      ],
      "description": "Track the Aqua yq bootstrap pins used before YAML parsing is available",
      "matchStrings": [
        "aqua:mikefarah/yq@(?<currentValue>v[0-9.]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "mikefarah/yq"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)dot/\\.config/devbase/packages\\.yaml$/"
      ],
      "description": "Track package pins while preserving the Temurin selector outside the Java version",
      "matchStrings": [
        "(?m)^\\s*[a-zA-Z0-9_.-]+:\\s+\\{[^}]*?\\bversion\\s*:\\s+\"?(?:temurin-)?(?<currentValue>[^\",}]+)\"?[^}]*?\\}\\s+#\\s+renovate:\\s+datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+?)(?:\\s+packageName=(?<packageName>\\S+?))?(?:\\s+extractVersion=(?<extractVersion>\\S+?))?\\s*$"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/tests/setup-bats-libs\\.sh$/"
      ],
      "description": "Update BATS helper library versions (bats-core)",
      "matchStrings": [
        "\\[\"(?<depName>bats-support|bats-assert|bats-file)\"\\]=\"(?<currentValue>v[0-9.]+)\""
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "bats-core/{{{depName}}}",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/tests/setup-bats-libs\\.sh$/"
      ],
      "description": "Update bats-mock version",
      "matchStrings": [
        "\\[\"(?<depName>bats-mock)\"\\]=\"(?<currentValue>v[0-9.]+)\""
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "jasonkarns/{{{depName}}}",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/dot/\\.config/fish/functions/devbase-citrix\\.fish$/"
      ],
      "description": "Update Citrix Workspace App for Linux version",
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=custom\\.citrix\\s+depName=(?<depName>\\S+)\\nset\\s+-g\\s+__citrix_version\\s+\"(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "custom.citrix",
      "versioningTemplate": "loose"
    }
  ],
  "customDatasources": {
    "citrix": {
      "defaultRegistryUrlTemplate": "https://www.citrix.com/downloads/workspace-app/linux/workspace-app-for-linux-latest.html",
      "format": "plain",
      "transformTemplates": [
        "{\"releases\": [$map($distinct($match($join(releases.version, \"\\n\"), /icaclient(?:-gcc-8)?_([0-9.]+)_amd64\\.deb/).groups[0]), function($v) { {\"version\": $v} })]}"
      ]
    },
    "jetbrains": {
      "defaultRegistryUrlTemplate": "https://data.services.jetbrains.com/products/releases?code={{packageName}}&type=release",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": [*.{\"version\": version, \"releaseTimestamp\": date}]}"
      ]
    },
    "openshift-oc": {
      "defaultRegistryUrlTemplate": "https://mirror.openshift.com/pub/openshift-v4/clients/ocp/",
      "format": "html",
      "transformTemplates": [
        "{\"releases\": $map(releases[$contains(version, /^[0-9]+\\.[0-9]+\\.[0-9]+\\/$/)], function($r) { {\"version\": $replace($r.version, /\\/$/, \"\")} })}"
      ]
    }
  }
}
